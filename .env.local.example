# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# OAuth Providers (configured in Supabase Dashboard)
# Get these from your OAuth provider setup:

# Google OAuth
# 1. Go to Google Cloud Console > APIs & Services > Credentials
# 2. Create OAuth 2.0 Client ID (Web application)
# 3. Add authorized redirect URI: https://YOUR_PROJECT_ID.supabase.co/auth/v1/callback
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=your-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth
# 1. Go to GitHub > Settings > Developer settings > OAuth Apps
# 2. Create new OAuth App
# 3. Set Authorization callback URL: https://YOUR_PROJECT_ID.supabase.co/auth/v1/callback
GITHUB_OAUTH_CLIENT_ID=your-github-client-id
GITHUB_OAUTH_CLIENT_SECRET=your-github-client-secret
